# Copy to .env on the server:  cp .env.example .env && nano .env
# NEVER commit .env. Only NEXT_PUBLIC_* values reach the browser.

# --- Public (baked into the web build) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co      # Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=                                  # publishable / anon key
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=                                # ElevenLabs > Agents > your agent
NEXT_PUBLIC_API_BASE_URL=https://demo3.ai-vance.de/api

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=                                      # Supabase > Project Settings > API (secret)
XAI_API_KEY=                                                    # Grok credits, claimed in Discord (/credits)
GROK_BOT_TOKEN=                                                 # if Grok Bot is called via its own endpoint/skill
V7_GO_API_KEY=                                                  # V7 Go > Settings > API keys
V7_GO_WORKSPACE_ID=
V7_GO_PROJECT_ID=                                               # the extraction agent/project for brochures
PARALLEL_API_KEY=                                               # platform.parallel.ai
MSCI_RCA_API_URL=                                               # Discord > Other credits > MSCI RCA
MSCI_RCA_API_KEY=
CORTILE_API_URL=                                                # Discord > Other credits > Cortile
CORTILE_API_KEY=
COGNEE_API_KEY=                                                 # Cognee cloud, or LLM key if self-hosted
COMPANIES_HOUSE_API_KEY=                                        # developer.company-information.service.gov.uk (free)
EPC_API_TOKEN=                                                  # get-energy-performance-data.communities.gov.uk (GOV.UK One Login)
ELEVENLABS_API_KEY=                                             # only if the agent is private (signed URLs)
# No key needed: postcodes.io, Element 84 Earth Search, OpenStreetMap/OSMnx, Land Registry CSV, UK HPI
# Comma-separated origins allowed to call the API from a browser (local UI dev)
CORS_ORIGINS=http://localhost:3000,https://demo3.ai-vance.de
