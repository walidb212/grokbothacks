# Copy to .env on the server:  cp .env.example .env && nano .env
# NEVER commit .env. Only NEXT_PUBLIC_* values reach the browser.

# --- Public (baked into the web build) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co      # Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=                                  # publishable / anon key
NEXT_PUBLIC_API_BASE_URL=https://demo3.ai-vance.de/api

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=                                      # Supabase > Project Settings > API (secret)
XAI_API_KEY=                                                    # Grok credits, claimed in Discord (/credits)
GROK_BOT_TOKEN=                                                 # if Grok Bot is called via its own endpoint/skill
V7_GO_API_KEY=                                                  # V7 Go > Settings > API keys
V7_GO_WORKSPACE_ID=
V7_GO_PROJECT_ID=                                               # the extraction agent/project for brochures
PARALLEL_API_KEY=                                               # platform.parallel.ai
MSCI_RCA_API_URL=                                               # Discord > Other credits > MSCI RCA
MSCI_RCA_API_KEY=
CORTILE_API_URL=                                                # Discord > Other credits > Cortile
CORTILE_API_KEY=
COGNEE_API_KEY=                                                 # Cognee cloud, or LLM key if self-hosted
COMPANIES_HOUSE_API_KEY=                                        # developer.company-information.service.gov.uk (free)
EPC_API_TOKEN=                                                  # get-energy-performance-data.communities.gov.uk (GOV.UK One Login)
ELEVENLABS_API_KEY=                                             # ElevenLabs > Developers > API keys (needs Agents access)
ELEVENLABS_AGENT_ID=                                            # printed by: python3 voice/setup_agent.py
# No key needed: postcodes.io, Element 84 Earth Search, OpenStreetMap/OSMnx, Land Registry CSV, UK HPI
# Comma-separated origins allowed to call the API from a browser (local UI dev)
CORS_ORIGINS=http://localhost:3000,https://demo3.ai-vance.de

# --- Chat agent (Grok via xAI, OpenAI-compatible). Without a key the chat falls back to simple keyword routing.
XAI_MODEL=grok-4.7
PUBLIC_BASE_URL=https://demo3.ai-vance.de                       # used to build OAuth redirect URIs

# --- Outlook (Microsoft Graph). Entra ID > App registrations > New registration:
#     Supported accounts: "Any Entra ID tenant + personal Microsoft accounts"
#     Redirect URI (Web): https://demo3.ai-vance.de/api/auth/outlook/callback
#     API permissions (delegated): Mail.Read, User.Read, offline_access. Then Certificates & secrets > New client secret.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common                                                # or your tenant id to restrict to your org

# --- Dealroom MCP (https://mcp.dealroom.co/mcp): no key. Users sign in with their Dealroom Premium account via the + menu;
#     the API registers itself as an OAuth client automatically.

# --- Gmail (Google OAuth): console.cloud.google.com > APIs & Services > enable Gmail API > Credentials > OAuth client ID (Web).
#     Authorized redirect URI: https://demo3.ai-vance.de/api/auth/gmail/callback
#     OAuth consent screen: add scope gmail.readonly and your test users (app stays in Testing mode for the demo).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
